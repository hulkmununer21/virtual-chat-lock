{
  "name": "Android Chat Lock Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/tailscale/codespace/tailscale:1": {
        "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mathiasfrohlich.Kotlin",
        "naco-siren.gradle-language",
        "saoudrizwan.claude-dev",
        "Continue.continue"
      ]
    }
  },
  "postStartCommand": "/bin/bash ./.devcontainer/setup-tailscale.sh"
}
